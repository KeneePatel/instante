{
  "name": "instante",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13 <27"
  },
  "scripts": {
    "dev": "scripts/dev.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm -C apps/web exec playwright test",
    "floor-guard": "node scripts/floor-guard.ts",
    "check:commits": "node scripts/check-commits.ts",
    "check:agent-settings": "node scripts/check-agent-settings.ts",
    "check:no-static": "node scripts/check-no-static.ts",
    "check:fast": "scripts/check-fast.sh",
    "check:task": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm floor-guard && pnpm check:agent-settings && pnpm check:commits",
    "check:full": "bash scripts/check-full.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
