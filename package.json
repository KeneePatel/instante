{
  "name": "instante",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13 <27"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit -p . && pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:fast": "scripts/check-fast.sh",
    "check:task": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
