# Every setting Instante reads, with development values where one is safe to share.
# Copy to .env for development. Real use never reads this file: `instante start`
# takes its settings from ~/.instante/config.env and its secrets from ~/.instante/secrets/.
# See docs/specs/platform.md, "Configuration".

# development, test or production. Only `instante start` sets production.
INSTANTE_ENV=development

# The scripts' data folder. Leave unset for development; tests always set a scratch one.
# INSTANTE_HOME=

# all, documents or cli
ROLE=all

# The backend listens on loopback only.
LISTEN_ADDRESS=127.0.0.1
PORT=8080

# The one Host the web app answers.
ALLOWED_HOST=localhost:3000

# Files holding the database URLs (secrets go in files, never in this file).
DATABASE_URL_FILE=
OWNER_DATABASE_URL_FILE=

# The document service's Unix socket (at most 104 bytes).
DOCUMENTS_SOCKET=

# Next.js sends anonymous telemetry to Vercel unless this is set; the web app's scripts set it too.
NEXT_TELEMETRY_DISABLED=1

# Fixed into the web build, and checked at start.
BACKEND_INTERNAL_URL=http://127.0.0.1:8080
